<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BDMusica.MainWindow"
        Title="Music Search" Width="400" Height="400">
    <StackPanel>
        <TextBlock Text="Escribe tu búsqueda:" Margin="10" />
        <TextBox Name="QueryTextBox" Height="30" Margin="10"/>
        <Button Name="SearchButton" Content="Buscar" Height="30" Margin="10" Click="SearchButton_Click"/>
        <ListBox Name="ResultsListView" Margin="10" />
    </StackPanel>
</Window>
